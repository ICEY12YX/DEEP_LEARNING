   "source": [
    "import matplotlib.pyplot as plt\n",
    "import numpy as np\n",
    "\n",
    "x = np.linspace(-1, 1, 50)\n",
    "# 意思是生成从-1到1的50个等间距的数值(绘图用的50个点)\n",
    "# y = 2 * x + 1 #线性函数\n",
    "y = x**2  # 二次函数\n",
    "\n",
    "# y也是50个点\n",
    "plt.plot(x, y)\n",
    "# 绘制x和y的关系曲线,注意顺序是先放横的x轴数据后y轴数据\n",
    "# 疑问:这个函数到底怎么用的\n",
    "plt.show()\n",
    "# 意思是显示绘制的图像"
   ]
  }
 ],
