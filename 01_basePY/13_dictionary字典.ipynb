   ],
   "source": [
    "# 就是键值对\n",
    "a_dic = {\"apple\": 1, \"pear\": 2, \"fan\": \"fanfanfan\"}\n",
    "print(a_dic[\"apple\"])\n",
    "print(a_dic[\"fan\"])\n",
    "\n",
    "del a_dic[\"pear\"]\n",
    "a_dic[\"banana\"] = 80\n",
    "print(a_dic)  # 字典没有顺序\n",
    "# 疑问: 那打印的时候按什么顺序?\n",
    "\n",
    "# 值还可以是列表,函数\n",
    "a_dic[\"peach\"] = [1, 2, 3]\n",
    "print(a_dic[\"peach\"][2])\n"
   ]
  }
